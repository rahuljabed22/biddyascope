ADMIN_PASSWORD=biddyascope-admin-2026

# Secret key for signing admin session cookies (set a strong random string in Vercel)
SESSION_SECRET=change-this-to-a-long-random-secret-key

# PostgreSQL connection string (Neon, Supabase, or Vercel Postgres)
